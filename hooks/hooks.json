{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.py\"" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/finish-gate.py\" --arm" }] }],
    "PostToolUseFailure": [{ "matcher": "Bash", "hooks": [{ "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/failure-match.py\"" }] }],
    "TaskCreated": [{ "hooks": [{ "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/task-verify.py\" --hook" }] }],
    "TaskCompleted": [{ "hooks": [{ "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/task-verify.py\" --hook" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/finish-gate.py\"" }] }]
  }
}
